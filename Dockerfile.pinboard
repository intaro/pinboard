# syntax=docker/dockerfile:1.7
#
# Pinboard — multi-stage production image
# Bundles: PHP 8.5-FPM + Nginx + Symfony app + pre-built frontend assets
#
# Build:
#   docker build -t xolegator/pinboard:latest -f Dockerfile.pinboard .
#
# Run (single container):
#   docker compose -f docker-compose.public.yml up -d
#

###############################################################################
# Stage 1 — Frontend: build Webpack Encore assets via pnpm
###############################################################################
FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS node-builder

WORKDIR /build

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# corepack reads the exact pnpm version from the "packageManager" field in
# package.json — the single source of truth shared by CI, Docker and dev hosts.
# Cache mounts keep the pnpm store and registry-metadata cache (used by the
# minimumReleaseAge supply-chain check) warm across local rebuilds.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    --mount=type=cache,id=pnpm-cache,target=/root/.cache/pnpm \
    corepack enable \
 && pnpm install --frozen-lockfile

COPY webpack.config.mjs ./
COPY assets/     ./assets/
COPY public/css/ ./public/css/

RUN pnpm run build

###############################################################################
# Stage 2 — PHP dependencies: composer install (no dev)
###############################################################################
FROM composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac AS composer-builder

WORKDIR /build

RUN apk add --no-cache libxslt-dev=~1.1 \
 && docker-php-ext-install -j"$(nproc)" xsl

COPY composer.json composer.lock symfony.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-autoloader \
    --no-scripts \
    --prefer-dist

# Copy source so dump-autoload can resolve class paths
COPY src/    ./src/
COPY config/ ./config/

RUN composer dump-autoload \
    --no-dev \
    --classmap-authoritative \
    --no-scripts

###############################################################################
# Stage 3 — Runtime: PHP-FPM + Nginx + Supervisord
###############################################################################
FROM php:8.5-fpm-alpine@sha256:fa01fb1645cd0fc566a5f146b099adace33b906571f972f71f2182a7c12d1cd7 AS runtime
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

# ── System packages ───────────────────────────────────────────────────────────
# Fuzzy pins (=~) hold the feature version but tolerate Alpine -rN security
# revisions. Do NOT use exact pins (pkg=x.y.z-rN): Alpine drops old revisions
# from its live repo, so exact pins rot and break the post-release image build.
#
# nginx comes from the official nginx.org stable repository for this Alpine
# release (the source the official nginx:*-alpine images use), not from Alpine:
# nginx.org ships security releases the same day, Alpine stable can lag for
# weeks (1.30.6, CVE-2026-93479 and four more, was missing from Alpine 3.24).
# apk takes the highest version across repositories, so nginx.org wins. The
# signing key is copied from the digest-pinned official nginx image.
COPY --from=nginx:1.30-alpine@sha256:970364228b1e4f932abc22d321932816782cca8a20b85a77552a7cfe9acfb3b5 \
     /etc/apk/keys/nginx_signing.rsa.pub /etc/apk/keys/nginx_signing.rsa.pub
RUN apk add --no-cache \
    --repository "https://nginx.org/packages/alpine/v$(cut -d. -f1,2 /etc/alpine-release)/main" \
    bash=~5.3 \
    curl=~8.22 \
    icu-dev=~78 \
    libxslt-dev=~1.1 \
    nginx=~1.30 \
    oniguruma-dev=~6.9 \
    supervisor=~4.3 \
    tzdata=~2026 \
 && docker-php-ext-install -j"$(nproc)" intl pdo_mysql xsl \
 && rm -rf /var/cache/apk/*

# ── Supercronic (production-grade cron runner) ────────────────────────────────
ENV SUPERCRONIC_VERSION=0.2.49 \
    SUPERCRONIC_SHA1SUM=e63c11a9726b775a6a11801e81af4f3fb926aa68
RUN curl -fsSL \
    "https://github.com/aptible/supercronic/releases/download/v${SUPERCRONIC_VERSION}/supercronic-linux-amd64" \
    -o /usr/local/bin/supercronic \
 && echo "${SUPERCRONIC_SHA1SUM}  /usr/local/bin/supercronic" | sha1sum -c - \
 && chmod +x /usr/local/bin/supercronic

# ── PHP runtime configuration ─────────────────────────────────────────────────
# Without a php.ini PHP runs on built-in defaults: display_errors and
# display_startup_errors on, log_errors off, assertions compiled in. Use the
# official production profile and layer Pinboard's overrides on top.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php-fpm/php.prod.ini "$PHP_INI_DIR/conf.d/zz-pinboard.ini"

# ── Nginx (single-container: php-fpm on 127.0.0.1:9000) ─────────────────────
COPY docker/nginx/nginx.prod.conf   /etc/nginx/nginx.conf
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /tmp/nginx /tmp/nginx/client_temp /tmp/nginx/proxy_temp /tmp/nginx/fastcgi_temp /tmp/nginx/uwsgi_temp /tmp/nginx/scgi_temp /var/log/nginx

# ── Supervisor ────────────────────────────────────────────────────────────────
COPY docker/php-fpm/supervisord.prod.conf /etc/supervisor/pinboard.conf

# ── Aggregate cron ────────────────────────────────────────────────────────────
COPY docker/php-fpm/aggregate.cron /etc/crontabs/aggregate.cron

# ── App user ─────────────────────────────────────────────────────────────────
# The php:*-alpine base already ships www-data as uid/gid 82, so these
# commands are a no-op there and the runtime user stays 82:82.
RUN addgroup -g 1000 -S www-data 2>/dev/null || true \
 && adduser  -u 1000 -S -D -G www-data www-data 2>/dev/null || true

# ── Application ──────────────────────────────────────────────────────────────
WORKDIR /var/www/pinboard

# PHP vendor (production, no dev, optimized autoloader)
COPY --from=composer-builder --chown=www-data:www-data /build/vendor ./vendor

# App source — only what runtime needs
COPY --chown=www-data:www-data bin/         ./bin/
COPY --chown=www-data:www-data config/      ./config/
COPY --chown=www-data:www-data migrations/  ./migrations/
COPY --chown=www-data:www-data public/      ./public/
COPY --chown=www-data:www-data src/         ./src/
COPY --chown=www-data:www-data templates/   ./templates/
COPY --chown=www-data:www-data .env         ./.env
COPY --chown=www-data:www-data composer.json composer.lock symfony.lock ./

# Pre-built frontend assets from Stage 1 (overrides empty public/build/)
COPY --from=node-builder --chown=www-data:www-data /build/public/build ./public/build/

# Symfony var/ must be writable at runtime
RUN mkdir -p var/cache var/log var/sessions \
 && chown -R www-data:www-data /var/www/pinboard /tmp/nginx /var/cache/nginx /var/log/nginx

# ── Entrypoint: waits for DB, runs migrations, starts supervisord ─────────────
COPY docker/php-fpm/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# ── Defaults ─────────────────────────────────────────────────────────────────
ENV APP_ENV=prod \
    APP_DEBUG=0

# Numeric uid:gid (the base image's www-data) so orchestrators such as
# Kubernetes can verify runAsNonRoot without reading /etc/passwd (DL3066).
USER 82:82

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# Web mode: nginx + php-fpm managed by supervisord
# Aggregate mode: override CMD with ["supercronic", "/etc/crontabs/aggregate.cron"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/pinboard.conf"]
